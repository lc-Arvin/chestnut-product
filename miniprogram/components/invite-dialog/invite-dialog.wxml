<view wx:if="{{visible}}" class="shade">
  <view class="dialog" role="dialog" aria-label="Invitation code">
    <view class="dialog-title">Start your meeting</view>
    <view class="hint">Enter your invitation code to continue.</view>
    <label class="input-label" for="invitation-code">Invitation code</label>
    <input id="invitation-code" class="code-input" password value="{{code}}" bindinput="input" disabled="{{busy}}" placeholder="Enter invitation code" aria-label="Invitation code" confirm-type="done" bindconfirm="submit" cursor-spacing="24" adjust-position="{{true}}" />
    <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
    <button class="verify" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{busy ? 'Verifying…' : 'Verify and continue'}}</button>
    <button class="cancel" bindtap="cancel">Not now</button>
  </view>
</view>
