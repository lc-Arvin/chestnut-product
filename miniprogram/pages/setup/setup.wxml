<view class="page-shell setup-page" style="padding-top: {{safeTop}}px">
  <view class="brand">
    <view class="brand-mark">✦</view>
    <text>ChestnutOne</text>
  </view>

  <view class="card setup-card">
    <text class="eyebrow">Conference Console</text>
    <view class="title">Meeting Setup</view>
    <view class="subtitle">多语言会议实时字幕与双向翻译</view>

    <view class="service-features">
      <view>实时双语字幕 · 多语言自动互译</view>
      <view>支持粤语与简体中文 · 会议稿保存</view>
      <view>选择语言 → 开始会议 → 检测麦克风 → 实时翻译</view>
      <view>可先了解服务，开始会议时再验证邀请码。</view>
    </view>
    <view class="settings">
      <view class="setting-row">
        <view class="setting-icon">文</view>
        <view class="setting-copy">
          <text class="setting-title">会议语言</text>
          <text class="setting-hint">自动识别发言语言</text>
        </view>
        <picker mode="multiSelector" range="{{languageRanges}}" value="{{languageIndices}}" bindchange="handleLanguageChange" aria-label="会议语言"><text class="setting-value">{{languagePairLabel}} ▾</text></picker>
      </view>

      <view class="setting-row">
        <view class="setting-icon">⌁</view>
        <view class="setting-copy">
          <text class="setting-title">声音来源</text>
          <text class="setting-hint">手机或电脑麦克风</text>
        </view>
        <view class="ready"><view class="status-dot"></view>Ready</view>
      </view>

      <view wx:if="{{cloudEnabled}}" class="setting-row">
        <view class="setting-icon">☁</view>
        <view class="setting-copy">
          <text class="setting-title">云端翻译服务</text>
          <text class="setting-hint">{{serverHint}}</text>
        </view>
        <view class="ready"><view class="status-dot"></view>Ready</view>
      </view>

      <view wx:else class="setting-row server-row">
        <view class="setting-icon">↗</view>
        <view class="setting-copy">
          <text class="setting-title">本地服务地址</text>
          <text class="setting-hint">{{serverHint}}</text>
        </view>
        <input
          class="server-input"
          value="{{serverHost}}"
          bindinput="handleHostInput"
          bindblur="saveHost"
          placeholder="{{serverPlaceholder}}"
          confirm-type="done"
        />
      </view>
    </view>

    <button class="primary-button" bindtap="startMeeting" loading="{{busy}}" disabled="{{busy}}">
      Start Meeting <text>→</text>
    </button>
    <button wx:if="{{pendingSave}}" bindtap="retrySave" disabled="{{busy}}">重试保存上一场会议稿</button>
    <view class="local-note">{{cloudEnabled ? 'CLOUD SERVICE · API Key 安全保存在服务端' : 'LOCAL MVP · API Key 仅保存在电脑端'}}</view>
  </view>
</view>

<invite-dialog visible="{{inviteVisible}}" bindverified="verified" bindcancel="cancelInvite" />
