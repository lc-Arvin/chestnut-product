.setup-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.setup-card {
  width: 100%;
  max-width: 900rpx;
  flex-shrink: 0;
  margin: 20rpx 0;
  padding: 36rpx 28rpx 32rpx;
}

.settings {
  margin: 30rpx 0 28rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.026);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
}

.setting-row {
  display: grid;
  grid-template-columns: 62rpx minmax(0, 1fr) auto;
  min-height: 112rpx;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-icon {
  display: grid;
  width: 54rpx;
  height: 54rpx;
  place-items: center;
  color: var(--blue);
  background: var(--blue-soft);
  border-radius: 15rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.setting-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.setting-title {
  font-size: 27rpx;
  font-weight: 630;
}

.setting-hint,
.setting-value {
  color: var(--muted);
  font-size: 21rpx;
}

.setting-value {
  max-width: 190rpx;
  text-align: right;
}

.ready {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--green);
  font-size: 23rpx;
  font-weight: 650;
}

.cloud-row { padding-top: 20rpx; padding-bottom: 20rpx; }
.cloud-row .setting-hint { line-height: 1.5; }
.cloud-status { color: var(--muted); font-size: 23rpx; white-space: nowrap; }
.cloud-status--connected { color: var(--green); font-weight: 650; }
.cloud-retry { margin: 0; padding: 8rpx 18rpx; color: var(--blue); background: var(--blue-soft); border-radius: 12rpx; font-size: 23rpx; line-height: 1.5; }
.cloud-retry::after { border: 0; }

.setup-brand { justify-content: center; margin-bottom: 26rpx; }
.invitation-hint { margin: 0 0 24rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: var(--blue-soft); color: var(--blue); font-size: 22rpx; line-height: 1.7; text-align: center; overflow-wrap: anywhere; }
.setup-card .title { font-size: 52rpx; letter-spacing: -2rpx; text-align: center; }
.setup-card .subtitle { font-size: 24rpx; text-align: center; }
.setup-card .primary-button { width: 100%; box-sizing: border-box; }
.language-row { grid-template-columns: 62rpx minmax(0, 1fr); padding-top: 20rpx; padding-bottom: 20rpx; }
.language-row picker { grid-column: 2; min-width: 0; }
.language-row .setting-value { display: block; max-width: none; text-align: left; line-height: 1.5; overflow-wrap: anywhere; }
