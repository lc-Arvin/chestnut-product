.live-page {
  display: flex;
  height: 100vh;
  box-sizing: border-box;
  flex-direction: column;
  gap: 12rpx;
  padding: calc(env(safe-area-inset-top) + 12rpx) calc(env(safe-area-inset-right) + 14rpx) calc(env(safe-area-inset-bottom) + 14rpx) calc(env(safe-area-inset-left) + 14rpx);
  overflow: hidden;
}

.topbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 14rpx;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid var(--line);
  border-radius: 23rpx;
}

.compact-brand {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 680;
}

.compact-brand .brand-mark {
  width: 44rpx;
  height: 44rpx;
  border-radius: 13rpx;
  font-size: 18rpx;
}

.session-status {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.live-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 14rpx;
  color: var(--red);
  background: rgba(217, 45, 32, 0.08);
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 760;
  letter-spacing: 1rpx;
}

.paused-pill {
  color: var(--amber);
  background: rgba(230, 162, 60, 0.13);
}

.live-dot {
  width: 11rpx;
  height: 11rpx;
  background: currentColor;
  border-radius: 50%;
}

.timer {
  margin: 0 4rpx;
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.tool-button {
  display: flex;
  min-width: 0;
  min-height: 58rpx;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  margin: 0;
  padding: 0 14rpx;
  background: rgba(0, 0, 0, 0.055);
  border-radius: 15rpx;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1;
}

.pause-symbol {
  font-size: 17rpx;
}

.stop-tool {
  color: var(--red);
  background: rgba(217, 45, 32, 0.08);
}

.stop-symbol {
  width: 13rpx;
  height: 13rpx;
  background: currentColor;
  border-radius: 3rpx;
}

.connection {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  gap: 11rpx;
  padding: 2rpx 8rpx 1rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.connection text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.connection-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  background: #e6a23c;
  border-radius: 50%;
}

.connection.connected .connection-dot {
  background: var(--green);
}

.connection.error .connection-dot,
.connection.disconnected .connection-dot {
  background: var(--red);
}

.connection button {
  min-height: 44rpx;
  margin: 0;
  padding: 0 14rpx;
  color: var(--blue);
  background: var(--blue-soft);
  border-radius: 12rpx;
  font-size: 19rpx;
  line-height: 44rpx;
}

.caption-stack {
  display: grid;
  min-height: 0;
  flex: 1;
  grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
  gap: 12rpx;
  overflow: hidden;
}

.caption-card {
  height: 100%;
  min-width: 0;
  min-height: 0;
  max-height: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--line);
  border-radius: 27rpx;
}

.chinese-card {
  background: rgba(0, 113, 227, 0.035);
  border-color: rgba(0, 113, 227, 0.12);
}

.language-label {
  position: sticky;
  z-index: 2;
  top: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-bottom: 18rpx;
  color: var(--muted);
  background: inherit;
  font-size: 21rpx;
  font-weight: 650;
}

.language-label text {
  display: grid;
  min-width: 44rpx;
  height: 40rpx;
  place-items: center;
  color: var(--blue);
  background: var(--blue-soft);
  border-radius: 12rpx;
  font-size: 17rpx;
}

.placeholder {
  display: flex;
  min-height: 160rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 28rpx;
  color: var(--muted);
  font-size: 25rpx;
  text-align: center;
}

.listening-rings {
  width: 24rpx;
  height: 24rpx;
  background: var(--blue);
  border-radius: 50%;
  box-shadow: 0 0 0 14rpx rgba(0, 113, 227, 0.08), 0 0 0 28rpx rgba(0, 113, 227, 0.035);
}

.caption-entry {
  display: flex;
  margin-bottom: 15rpx;
  padding: 18rpx 20rpx;
  flex-direction: column;
  gap: 9rpx;
  border-left: 5rpx solid transparent;
  border-radius: 0 18rpx 18rpx 0;
}

.caption-entry.original {
  background: var(--blue-soft);
  border-left-color: var(--blue);
}

.caption-entry.translation {
  background: var(--purple-soft);
  border-left-color: var(--purple);
}

.caption-entry.current {
  opacity: 0.72;
}

.role-label {
  align-self: flex-start;
  padding: 5rpx 9rpx;
  border-radius: 8rpx;
  font-size: 15rpx;
  font-weight: 760;
  letter-spacing: 1rpx;
}

.original .role-label {
  color: var(--blue);
  background: rgba(0, 113, 227, 0.1);
}

.translation .role-label {
  color: var(--purple);
  background: rgba(125, 73, 190, 0.11);
}

.caption-text {
  font-size: 32rpx;
  font-weight: 520;
  letter-spacing: -1rpx;
  line-height: 1.42;
}

.scroll-anchor {
  height: 1rpx;
}

.footer-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 1rpx 10rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.footer-status > view {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.is-paused .caption-stack {
  opacity: 0.72;
}

@media (max-width: 480px) {
  .compact-brand {
    width: 100%;
  }

  .session-status {
    width: 100%;
    box-sizing: border-box;
    flex: none;
    justify-content: space-between;
    gap: 6rpx;
  }

  .tool-button {
    padding: 0 12rpx;
  }
}

@media (orientation: landscape) {
  .live-page {
    gap: 8rpx;
    padding-bottom: calc(env(safe-area-inset-bottom) + 8rpx);
  }

  .topbar {
    gap: 7rpx 12rpx;
    padding: 8rpx 10rpx;
  }

  .connection {
    padding-top: 0;
    padding-bottom: 0;
    font-size: 18rpx;
  }

  .caption-stack {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    gap: 10rpx;
  }

  .caption-card {
    padding: 18rpx;
    border-radius: 22rpx;
  }

  .language-label {
    padding-bottom: 12rpx;
  }

  .caption-entry {
    margin-bottom: 10rpx;
    padding: 14rpx 16rpx;
  }

  .caption-text {
    font-size: 28rpx;
  }

  .footer-status {
    display: none;
  }
}

@media (min-width: 900px) and (orientation: portrait) {
  .caption-stack {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
  }
}
