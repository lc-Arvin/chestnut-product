# 完整说明：docs/CLOUD_DEPLOYMENT.md。复制为 .env 后填写；不要提交真实配置。
# 默认本地 SQLite。云端模板见 .env.cloud.example；两套数据互不导入、同步。
# 系统环境变量优先。值含空格、#、$ 时请用引号；此文件不会作为 shell 脚本执行。

# 运行模式：local / cloud。cloud 强制 MySQL、HTTPS 域名、强签名密钥。
CHESTNUT_ENV="local"
# SQLite / MySQL 数据层：sqlite / mysql；本地也可选择 mysql 做联调。
CHESTNUT_DATABASE_BACKEND="sqlite"
# 监听地址。本机调试 127.0.0.1；手机局域网/容器用 0.0.0.0。
CHESTNUT_HOST="127.0.0.1"
# HTTP 与 WebSocket 共用端口；若设置 PORT 则优先使用 PORT。
CHESTNUT_PORT="8080"
# PORT="8080"
# 本地管理启动器的独立端口覆盖，优先于 PORT。
# CHESTNUT_LOCAL_ADMIN_PORT="8080"
# 可在系统环境中指定另一个配置文件；不在当前 .env 内设置自身路径。
# CHESTNUT_ENV_FILE=".env.local"

# 百炼：API Key 与业务空间 API Host，Host 不带 https:// 或路径。
DASHSCOPE_API_KEY=""
BAILIAN_API_HOST=""

# 管理页面开关。1 开启 /admin；0 关闭页面但 MySQL 仍保护会议接口。
# start_admin_local.py 会强制使用本地模式、SQLite、本地会议稿，并开启后台。
CHESTNUT_ADMIN_ENABLED="1"
# 仅 SQLite 生效，本地后台密码、邀请码、统计和会话存放于此。
CHESTNUT_ADMIN_DB="data/admin.sqlite3"
# 仅云端首次开启后台时必填，12–200 字符；已有密码时不会覆盖。
# 首次成功启动后可从云端配置删除此值；修改它不会重置管理员密码。
CHESTNUT_ADMIN_BOOTSTRAP_PASSWORD=""

# 仅 MySQL 后端必填。地址与端口分开；本机连外网，云容器连内网。
# 云上：10.34.104.109 / 3306。
# 本地联调：sh-cynosdbmysql-grp-9zp4wms6.sql.tencentcdb.com / 27839。
CHESTNUT_MYSQL_HOST=""
CHESTNUT_MYSQL_PORT="3306"
# 独立业务库，需要先创建。应用启动自动建表，不创建数据库。
CHESTNUT_MYSQL_DATABASE="chestnut"
CHESTNUT_MYSQL_USER=""
CHESTNUT_MYSQL_PASSWORD=""
# 连接、读取和写入超时，1–60 秒。
CHESTNUT_MYSQL_TIMEOUT_SECONDS="10"
# 可选服务端 CA 文件路径；填写后严格验证证书与主机名，禁止跳过校验。
CHESTNUT_MYSQL_SSL_CA=""
# 兼容已有变量：仅在上面的 USER/PASSWORD 为空时使用。
CHESTNUT_CLOUD_DB_ADMIN=""
CHESTNUT_CLOUD_DB_PASSWORD=""

# 云端必填：Web 实际访问的 HTTPS 源，含非标准端口时带端口，不带路径。
CHESTNUT_PUBLIC_ORIGIN=""
# 信任的网关 IP/CIDR，以逗号分隔。只填写实际网关来源；默认不信任代理头。
# 用于解析真实 IP、接受微信网关注入的 X-WX-OpenID。不要填 0.0.0.0/0。
CHESTNUT_TRUSTED_PROXY_CIDRS=""
# 签名密钥：云端必填，至少 32 字符，长期保持不变，和管理员密码不同。
# 本地 SQLite 留空时使用数据库自动生成的密钥。
CHESTNUT_AUTH_SECRET=""
# 邀请凭证有效期（秒），必须大于 0；邀请码停用/到期仍立即撤销访问。
CHESTNUT_WEB_TOKEN_TTL_SECONDS="43200"
# 旧版静态邀请码，逗号分隔 label=code。MySQL 模式不会导入，云端留空。
CHESTNUT_WEB_INVITE_CODES=""
# 仅本地模式使用的 Origin 白名单；留空为同 Host。云端仅接受 PUBLIC_ORIGIN。
CHESTNUT_ALLOWED_ORIGINS=""

# 会议稿存储：auto / local / mysql / cos。
# auto：有 COS_BUCKET 则 COS，否则 MySQL 后端存 MySQL，SQLite 存本地文件。
# 云端禁止 local。保存的是 Markdown 文本，不保存原始音频。
CHESTNUT_TRANSCRIPT_STORAGE="auto"
# 仅 cos 模式填写；Bucket 含 APPID 后缀，Region 如 ap-shanghai。
CHESTNUT_COS_BUCKET=""
CHESTNUT_COS_REGION=""
# 仅在平台未注入临时 COS 凭据时填写；授予指定 Bucket 的读写权限。
CHESTNUT_COS_SECRET_ID=""
CHESTNUT_COS_SECRET_KEY=""
# 使用临时 COS 凭证时的 token；长期子账号凭证留空。
CHESTNUT_COS_SESSION_TOKEN=""
# 平台环境可注入 TENCENTCLOUD_REGION / TENCENTCLOUD_SECRETID /
# TENCENTCLOUD_SECRETKEY / TENCENTCLOUD_SESSIONTOKEN，优先于上面的 COS 配置。

# 新客试用秒数：0 关闭，默认 180，最大按 900 执行；成功连接翻译后计时。
CHESTNUT_TRIAL_SECONDS="180"
# 单场会议上限秒数，0 不限；提前提醒秒数。
CHESTNUT_MAX_MEETING_SECONDS="3600"
CHESTNUT_MEETING_WARNING_SECONDS="300"
# 单进程最大同时会议数，0 不限。本版云托管须配置单实例。
CHESTNUT_MAX_CONCURRENT_MEETINGS="20"
# 单网络来源的邀请码验证限流：窗口内允许次数 / 窗口秒数；0 次数关闭限流。
CHESTNUT_LOGIN_RATE_LIMIT="5"
CHESTNUT_LOGIN_RATE_WINDOW_SECONDS="600"
# 单用户+网络来源的 WebSocket 重连限流。
CHESTNUT_CONNECTION_RATE_LIMIT="10"
CHESTNUT_CONNECTION_RATE_WINDOW_SECONDS="60"

# 百炼发送超时、检测到有效音频后的响应等待时限（秒），须大于 0。
CHESTNUT_CLOUD_SEND_TIMEOUT="10"
CHESTNUT_CLOUD_RESPONSE_TIMEOUT="60"
# 本地日志文件，5 MB 轮转、保留 5 份；设为空只输出终端，云端推荐为空。
CHESTNUT_LOG_FILE="logs/chestnut.log"
