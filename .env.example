# Copy this file to .env and fill in your own Bailian credentials.
DASHSCOPE_API_KEY="your-bailian-api-key"
BAILIAN_API_HOST="your-workspace.cn-beijing.maas.aliyuncs.com"

# Optional persistent transcript storage in WeChat CloudBase Run.
CHESTNUT_COS_BUCKET=""
CHESTNUT_COS_REGION=""
CHESTNUT_COS_SECRET_ID=""
CHESTNUT_COS_SECRET_KEY=""

# Optional local bind address and unified HTTP/WebSocket port
CHESTNUT_HOST="127.0.0.1"
CHESTNUT_PORT="8080"

# Optional reliability and diagnostics settings.
CHESTNUT_LOG_FILE="logs/chestnut.log"
CHESTNUT_CLOUD_SEND_TIMEOUT="10"
CHESTNUT_CLOUD_RESPONSE_TIMEOUT="60"

# Optional Web private-preview protection. Leave invite codes empty for local
# development. For cloud use, configure comma-separated label=code entries.
# Labels appear in transcript filenames; codes never do.
CHESTNUT_WEB_INVITE_CODES=""
CHESTNUT_AUTH_SECRET=""
CHESTNUT_WEB_TOKEN_TTL_SECONDS="43200"

# Access and cost controls. Use 0 seconds for no meeting time limit.
CHESTNUT_MAX_MEETING_SECONDS="3600"
CHESTNUT_MEETING_WARNING_SECONDS="300"
CHESTNUT_MAX_CONCURRENT_MEETINGS="20"
CHESTNUT_LOGIN_RATE_LIMIT="5"
CHESTNUT_LOGIN_RATE_WINDOW_SECONDS="600"
CHESTNUT_CONNECTION_RATE_LIMIT="10"
CHESTNUT_CONNECTION_RATE_WINDOW_SECONDS="60"

# Optional comma-separated HTTPS origins. Empty means same-host Web requests.
CHESTNUT_ALLOWED_ORIGINS=""
