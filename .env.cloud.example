# 云托管环境变量模板。逐项说明及其他可选配置见 .env.example 和 docs/CLOUD_DEPLOYMENT.md。
# 不把真实配置文件打进镜像；在云托管控制台/密钥配置中注入变量。
CHESTNUT_ENV="cloud"
CHESTNUT_DATABASE_BACKEND="mysql"
CHESTNUT_HOST="0.0.0.0"
PORT="8080"
CHESTNUT_PUBLIC_ORIGIN="https://your-meeting-domain.example"
# 替换为实际网关出口 CIDR；留空不信任 X-WX-OpenID 和 X-Forwarded-For。
CHESTNUT_TRUSTED_PROXY_CIDRS=""
CHESTNUT_AUTH_SECRET=""
CHESTNUT_ADMIN_ENABLED="1"
CHESTNUT_ADMIN_BOOTSTRAP_PASSWORD=""
DASHSCOPE_API_KEY=""
BAILIAN_API_HOST=""

CHESTNUT_MYSQL_HOST="10.34.104.109"
CHESTNUT_MYSQL_PORT="3306"
CHESTNUT_MYSQL_DATABASE="chestnut"
CHESTNUT_MYSQL_USER=""
CHESTNUT_MYSQL_PASSWORD=""
CHESTNUT_MYSQL_TIMEOUT_SECONDS="10"
CHESTNUT_MYSQL_SSL_CA=""
CHESTNUT_TRANSCRIPT_STORAGE="mysql"

CHESTNUT_WEB_TOKEN_TTL_SECONDS="43200"
CHESTNUT_TRIAL_SECONDS="180"
CHESTNUT_MAX_MEETING_SECONDS="3600"
CHESTNUT_MEETING_WARNING_SECONDS="300"
CHESTNUT_MAX_CONCURRENT_MEETINGS="20"
CHESTNUT_LOGIN_RATE_LIMIT="5"
CHESTNUT_LOGIN_RATE_WINDOW_SECONDS="600"
CHESTNUT_CONNECTION_RATE_LIMIT="10"
CHESTNUT_CONNECTION_RATE_WINDOW_SECONDS="60"
CHESTNUT_CLOUD_SEND_TIMEOUT="10"
CHESTNUT_CLOUD_RESPONSE_TIMEOUT="60"
CHESTNUT_LOG_FILE=""
